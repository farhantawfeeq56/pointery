{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pointery-config",
  "title": "pointery.config.json - schema is truth for every key an app or its AI may change",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "trigger": { "type": "string", "description": "'+'-joined combo, e.g. shift+a. ctrl/cmd treated the same." },
    "theme": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "accent": { "type": "string" },
        "background": { "type": "string" },
        "text": { "type": "string" },
        "border": { "type": "string" },
        "radius": { "type": "number" },
        "fontFamily": { "type": "string", "description": "CSS font-family stack for the palette/toast/guide. Defaults to bundled Figtree." }
      },
      "additionalProperties": false
    },
    "cssVars": { "type": "object", "additionalProperties": { "type": "string" } },
    "zIndex": { "type": "number" },
    "paletteWidth": { "type": "number" },
    "overlayBlur": { "type": "number" },
    "fab": { "description": "false hides the idle button, string sets its glyph.", "type": ["boolean", "string"] },
    "hiddenRoutes": { "type": "array", "items": { "type": "string" } },
    "timing": {
      "type": "object",
      "properties": {
        "toastMs": { "type": "number" },
        "pulseMs": { "type": "number" },
        "closeMs": { "type": "number" },
        "focusMs": { "type": "number" },
        "navigateMs": { "type": "number" },
        "navigateIdleMs": { "type": "number" }
      },
      "additionalProperties": false
    },
    "position": { "type": "string", "enum": ["top", "center", "bottom"] },
    "animation": { "type": "string", "enum": ["fade", "slide", "scale", "none"] },
    "suggestions": { "type": "array", "items": { "type": "string" } },
    "allowActions": { "type": "array", "items": { "type": "string" } },
    "labels": {
      "type": "object",
      "properties": {
        "placeholder": { "type": "string" },
        "empty": { "type": "string" },
        "confirmTitle": { "type": "string" },
        "asking": { "type": "string" },
        "blocked": { "type": "string" },
        "done": { "type": "string" },
        "unreachable": { "type": "string" },
        "missing": { "type": "string" },
        "pressEnter": { "type": "string" },
        "guideComplete": { "type": "string" },
        "ambiguous": { "type": "string" },
        "confirmBody": { "type": "string" },
        "back": { "type": "string" },
        "next": { "type": "string" },
        "doneBtn": { "type": "string" },
        "cancel": { "type": "string" },
        "confirmBtn": { "type": "string" },
        "fabLabel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "endpoint": { "type": "string" },
    "brain": {
      "type": "object",
      "properties": {
        "retrieve": {
          "type": "object",
          "properties": {
            "entries": { "type": "number" },
            "flows": { "type": "number" },
            "actions": { "type": "number" }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "queryMax": { "type": "number" },
            "planMax": { "type": "number" }
          },
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "properties": {
            "ttlMs": { "type": "number" },
            "max": { "type": "number" }
          },
          "additionalProperties": false
        },
        "llm": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number" },
            "maxTokens": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
