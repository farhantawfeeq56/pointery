{
  "name": "pointery",
  "version": "0.2.1",
  "description": "Ask anything in-app: palette, guides, and allowlisted actions for any SaaS.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "default": "./dist/resolver.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./schema.json": "./schema.json",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json",
    "src/styles.css",
    "fonts",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pointery": "bin/pointery.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "in-app-search",
    "command-palette",
    "user-guides",
    "onboarding",
    "nextjs",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhantawfeeq56/pointery.git",
    "directory": "packages/pointery"
  }
}
