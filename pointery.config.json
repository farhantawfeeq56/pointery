{
  "$schema": "./node_modules/pointery/schema.json",
  "trigger": "ctrl+k",
  "theme": {
    "primary": "#235789",
    "radius": 14
  },
  "position": "bottom",
  "animation": "slide",
  "suggestions": [
    "Where is export?",
    "How do I invite a teammate?",
    "Show me the pipeline table"
  ],
  "allowActions": [
    "mark-won",
    "invite-teammate",
    "export-pipeline"
  ],
  "labels": {
    "placeholder": "Ask \"where is export?\" or \"how do I invite?\"",
    "empty": "No match - try “export”, “invite”, or “pipeline”.",
    "confirmTitle": "Run this action?"
  },
  "endpoint": "/api/ask",
  "closed": { "variant": "fab", "icon": "?", "label": "Ask" },
  "hiddenRoutes": ["/"],
  "timing": {
    "toastMs": 4200,
    "pulseMs": 2600,
    "closeMs": 160,
    "focusMs": 30,
    "navigateMs": 450,
    "navigateIdleMs": 50
  },
  "zIndex": 60,
  "paletteWidth": 560,
  "overlayBlur": 2,
  "brain": {
    "retrieve": {
      "entries": 8,
      "flows": 3,
      "actions": 3
    },
    "limits": {
      "queryMax": 200,
      "planMax": 4
    },
    "cache": {
      "ttlMs": 300000,
      "max": 200
    },
    "llm": {
      "temperature": 0,
      "maxTokens": 300
    }
  }
}
